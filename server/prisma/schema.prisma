datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  companyName   String
  role          String
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rfqs          RFQ[]          @relation("BuyerRFQs")
  quotations    Quotation[]    @relation("SupplierQuotes")
  notifications Notification[]
}

model RFQ {
  id               Int          @id @default(autoincrement())
  title            String
  description      String
  category         String
  quantity         Int
  unit             String
  deliveryLocation String
  deadline         DateTime
  targetBudget     Float?
  status           String       @default("OPEN")
  buyerId          Int
  buyer            User         @relation("BuyerRFQs", fields: [buyerId], references: [id], onDelete: Cascade)
  quotations       Quotation[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Quotation {
  id           Int         @id @default(autoincrement())
  rfqId        Int
  rfq          RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId   Int
  supplier     User        @relation("SupplierQuotes", fields: [supplierId], references: [id], onDelete: Cascade)
  price        Float
  deliveryDays Int
  validUntil   DateTime?
  notes        String
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([rfqId, supplierId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}