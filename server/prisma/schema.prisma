datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SUPPLIER
}

enum RFQStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
  AWARDED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  companyName   String
  role          Role
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rfqs          RFQ[]          @relation("BuyerRFQs")
  quotations    Quotation[]    @relation("SupplierQuotes")
  notifications Notification[]

  @@index([role])
}

model RFQ {
  id               Int          @id @default(autoincrement())
  title            String       // Product or Service name
  description      String       @db.Text
  category         String       // Electronics, Construction, Logistics, Packaging, etc.
  quantity         Int
  unit             String       // Units, Tons, Pieces, Liters, etc.
  deliveryLocation String
  deadline         DateTime
  targetBudget     Decimal?     @db.Decimal(12, 2)
  status           RFQStatus    @default(OPEN)
  buyerId          Int
  buyer            User         @relation("BuyerRFQs", fields: [buyerId], references: [id], onDelete: Cascade)
  quotations       Quotation[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([category])
}

model Quotation {
  id           Int         @id @default(autoincrement())
  rfqId        Int
  rfq          RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId   Int
  supplier     User        @relation("SupplierQuotes", fields: [supplierId], references: [id], onDelete: Cascade)
  price        Decimal     @db.Decimal(12, 2)
  deliveryDays Int         // Estimated delivery in days
  validUntil   DateTime?
  notes        String      @db.Text
  status       QuoteStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([rfqId, supplierId]) // A supplier can only submit 1 quotation per RFQ
  @@index([supplierId])
  @@index([rfqId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // NEW_QUOTE, QUOTE_ACCEPTED, QUOTE_REJECTED, RFQ_UPDATE
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}
